# ── CEM — Centro Educacional Milezi ──────────────────────────
# Copie para .env e ajuste. O .env nunca vai para o Git.

PORT=3300

# Segredo dos tokens JWT — EXCLUSIVO deste sistema.
# Nunca reutilize o do SuperPet ou do CicleSystem: com o mesmo
# segredo, um token de lá seria aceito aqui.
# Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-antes-de-publicar
JWT_EXPIRES=12h

# Credenciais iniciais do master (criadas pelo seed na 1a execução)
MASTER_LOGIN=master
MASTER_SENHA=cem@2026

# Caminhos opcionais
# DB_PATH=/var/www/cem/dados/cem.db
# UPLOAD_DIR=/var/www/cem/uploads
