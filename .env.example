# ── CEM — Centro Educacional Milezi ──────────────────────────
# Copie para .env e ajuste. O .env nunca vai para o Git.

# Fuso horario do servidor. Sem isso, uma VPS configurada em UTC (comum
# em provedores de nuvem) grava todo horario 3h adiantado.
TZ=America/Sao_Paulo

PORT=3300

# Segredo dos tokens JWT — EXCLUSIVO deste sistema.
# Nunca reutilize o do SuperPet ou do CicleSystem: com o mesmo
# segredo, um token de lá seria aceito aqui.
# Gere um novo com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-este-segredo-antes-de-publicar
JWT_EXPIRES=12h

# Credenciais iniciais do master (criadas pelo seed na 1a execução)
MASTER_LOGIN=master
MASTER_SENHA=cem@2026

# Caminhos opcionais
# DB_PATH=/var/www/cem/dados/cem.db
# UPLOAD_DIR=/var/www/cem/uploads

# Teste beta: mostra o aviso ">>> BETA <<<" no menu e libera, so para o
# Master, o botao de zerar todos os dados do sistema. Apague esta linha
# (ou mude para false) quando o sistema for para producao de verdade.
BETA=true

# Notificacoes push (mensagens e ocorrencias no app dos responsaveis).
# Gere o seu proprio par com:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@suaescola.com.br
